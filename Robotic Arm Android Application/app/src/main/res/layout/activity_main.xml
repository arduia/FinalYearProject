<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Robotic Arm Controller"
            app:titleTextColor="@color/white"/>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Connection Status -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="○ Disconnected"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:chipBackgroundColor="@color/status_disconnected"
                app:chipCornerRadius="8dp"/>

            <TextView
                android:id="@+id/tv_current_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Move sliders to control the arm"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:ellipsize="end"
                android:maxLines="1"/>

            <!-- Shoulder -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="SHOULDER"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:letterSpacing="0.1"/>

                        <TextView
                            android:id="@+id/tv_shoulder_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="90°"
                            android:textSize="20sp"
                            android:textColor="@color/primary"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_shoulder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="180"
                        android:value="90"
                        android:stepSize="1"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Base -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="BASE"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:letterSpacing="0.1"/>

                        <TextView
                            android:id="@+id/tv_base_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="90°"
                            android:textSize="20sp"
                            android:textColor="@color/primary"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_base"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="180"
                        android:value="90"
                        android:stepSize="1"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Elbow -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ELBOW"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:letterSpacing="0.1"/>

                        <TextView
                            android:id="@+id/tv_elbow_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="90°"
                            android:textSize="20sp"
                            android:textColor="@color/primary"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_elbow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="180"
                        android:value="90"
                        android:stepSize="1"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Wrist -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="WRIST"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:letterSpacing="0.1"/>

                        <TextView
                            android:id="@+id/tv_wrist_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="90°"
                            android:textSize="20sp"
                            android:textColor="@color/primary"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_wrist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="180"
                        android:value="90"
                        android:stepSize="1"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Wrist Spin -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="WRIST SPIN"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:letterSpacing="0.1"/>

                        <TextView
                            android:id="@+id/tv_wrist_spin_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="90°"
                            android:textSize="20sp"
                            android:textColor="@color/primary"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_wrist_spin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="180"
                        android:value="90"
                        android:stepSize="1"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Gripper -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="GRIPPER"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:letterSpacing="0.1"/>

                        <TextView
                            android:id="@+id/tv_gripper_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="90°"
                            android:textSize="20sp"
                            android:textColor="@color/primary"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_gripper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="180"
                        android:value="90"
                        android:stepSize="1"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Log Output Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/log_background"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="LOG OUTPUT"
                        android:textSize="10sp"
                        android:textColor="@color/log_header"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tv_log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="@color/log_text"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="2dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Send Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="SEND COMMAND"
                android:textSize="14sp"
                android:letterSpacing="0.08"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                app:cornerRadius="12dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
